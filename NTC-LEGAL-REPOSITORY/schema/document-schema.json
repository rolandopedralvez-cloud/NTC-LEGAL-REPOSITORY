{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NTC Legal Document Metadata Schema",
  "description": "Metadata contract every converted law/MC section must satisfy",
  "type": "object",
  "required": ["id", "title", "type", "status", "effective_date"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable, permanent unique identifier, e.g. mc-title-3-sec-12",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "description": "Human-readable title, e.g. 'Section 3.12 - Noise Ordinance'"
    },
    "type": {
      "type": "string",
      "enum": ["municipal_code", "law", "ordinance", "resolution", "regulation"]
    },
    "status": {
      "type": "string",
      "enum": ["active", "amended", "repealed", "superseded", "proposed"]
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "last_amended_date": {
      "type": "string",
      "format": "date"
    },
    "source_ordinance": {
      "type": "string",
      "description": "Ordinance/law number that enacted this section"
    },
    "amendment_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": { "type": "string", "format": "date" },
          "ordinance": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "cross_references": {
      "type": "array",
      "description": "IDs of other sections this document references",
      "items": { "type": "string" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "jurisdiction": {
      "type": "string",
      "description": "e.g. 'NTC' or specific district/department"
    }
  }
}
